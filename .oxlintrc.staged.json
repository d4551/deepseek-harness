{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.json"],
  "options": {
    "typeAware": false,
    // This pass does not run type-aware rules, so it cannot tell whether a
    // type-aware suppression is used: every `typescript/unbound-method`
    // directive in a staged file would be reported as unused. The root config
    // keeps this an error, where the rules that consume those directives run.
    "reportUnusedDisableDirectives": "allow"
  },
  "ignorePatterns": [
    "**/lib/**",
    "**/node_modules/**",
    "**/.sessions/**",
    ".claude/**",
    "**/.doc-typecheck-*/**",
    "**/.node-next-types-*/**",
    "packages/typert/generator/tests/.probe-*/**",
    "packages/typert/generator/tests/.generated-*/**",
    "packages/typert/generator/tests/.rendered-*/**",
    "packages/typert/generator/tests/.typert-*/**",
    "website/.generated/**",
    "vendor/**",
    "native/**",
    "**/*.js",
    "**/*.mjs",
    "**/*.config.ts",
    "packages/client/tsdown.client.ts"
  ]
}
