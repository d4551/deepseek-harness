    tuple: [
        head: string,
        count?: number,
        ...tail: boolean[]
    ];
    unnamedTuple: [
        string?,
        ...number[]
    ];
    readonlyTuple: readonly [
        string,
        number
    ];
    object: {
        readonly value?: string;
