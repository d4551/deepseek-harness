+import assert from 'node:assert/strict'
+import { mkdtemp, readFile, realpath, rm, writeFile } from 'node:fs/promises'
+import { Session } from 'node:inspector/promises'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { test } from 'node:test'
+import { pathToFileURL } from 'node:url'
+import { Script } from 'node:vm'
+import { createVitest } from '../packages/vitest/src/public/node.ts'
+import { V8CoverageProvider } from '../packages/coverage-v8/src/provider.ts'
+import collector from '../packages/coverage-v8/src/index.ts'
+
+async function startCollection(t, filename) {
+  await collector.startCoverage({ isolate: true, autoAttachSubprocess: false, reportsDirectory: dirname(filename) })
+  t.after(() => collector.stopCoverage({ isolate: true }))
+}
+
+async function collect(provider, filename) {
+  const report = await collector.takeCoverage({ coverageFilesDirectory: dirname(filename) })
+  assert.equal(typeof report, 'string')
+  provider.onAfterSuiteRun({ coverage: report, environment: 'ssr', projectName: '', testFiles: [filename] })
+  return { report, coverage: await provider.generateCoverage({ allTestsRun: false }) }
+}
+
+async function project(t, source, viteModuleRunner, plugins = []) {
+  const root = await realpath(await mkdtemp(join(tmpdir(), 'vitest-source-integrity-')))
+  t.after(() => rm(root, { recursive: true, force: true }))
+  const filename = join(root, 'payload.js')
+  await writeFile(filename, source)
+  const vitest = await createVitest({
+    root,
+    config: false,
+    watch: false,
+    experimental: { viteModuleRunner },
+    coverage: {
+      enabled: true,
+      provider: 'v8',
+      include: ['payload.js'],
+      exclude: [],
+      reporter: ['json'],
+      thresholds: { 100: true, perFile: true },
+    },
+  }, { plugins })
+  t.after(() => vitest.close())
+  const provider = new V8CoverageProvider()
+  provider.initialize(vitest)
+  return { provider, filename }
+}
+
+test('coverage rejects a native source that cannot be parsed', async (t) => {
+  const { provider } = await project(t, 'export const value = ;', false)
+  await assert.rejects(provider.generateCoverage({ allTestsRun: true }), /Unexpected token|Expression expected/)
+})
+
+test('coverage preserves a Vite transform failure', async (t) => {
+  const failure = new Error('source-integrity transform rejected')
+  const { provider } = await project(t, 'export const value = 17;', true, [{
+    name: 'source-integrity-rejection',
+    transform(_code, id) {
+      if (id.endsWith('/payload.js')) throw failure
+    },
+  }])
+  await assert.rejects(provider.generateCoverage({ allTestsRun: true }), /source-integrity transform rejected/)
+})
+
+test('valid native source retains its unexecuted statement and function', async (t) => {
+  const { provider, filename } = await project(t, 'export function value() { return 17; }', false)
+  const coverage = await provider.generateCoverage({ allTestsRun: true })
+  assert.deepEqual(coverage.files(), [filename])
+  const result = coverage.fileCoverageFor(filename).toSummary()
+  assert.ok(result.statements.total > 0)
+  assert.equal(result.statements.covered, 0)
+  assert.equal(result.functions.total, 1)
+  assert.equal(result.functions.covered, 0)
+})
+
+test('coverage rejects unavailable executed source instead of fabricating code', async (t) => {
+  const { provider, filename } = await project(t, 'export function value() { return 17; }', false)
+  const session = new Session()
+  session.connect()
+  t.after(() => session.disconnect())
+  await session.post('Profiler.enable')
+  await session.post('Profiler.startPreciseCoverage', { callCount: true, detailed: true })
+  const loaded = await import(pathToFileURL(filename).href)
+  assert.equal(loaded.value(), 17)
+  const coverage = await session.post('Profiler.takePreciseCoverage')
+  await session.post('Profiler.stopPreciseCoverage')
+  await session.post('Profiler.disable')
+  const executed = coverage.result.find(entry => entry.url === pathToFileURL(filename).href)
+  assert.ok(executed)
+  assert.ok(executed.functions.some(fn => fn.functionName === 'value' && fn.ranges.some(range => range.count > 0)))
+  const report = `${filename}.coverage.json`
+  await writeFile(report, JSON.stringify({ result: [{ ...executed, startOffset: 0, isExtendedContext: true }] }))
+  await rm(filename)
+  provider.onAfterSuiteRun({ coverage: report, environment: 'ssr', projectName: '', testFiles: [filename] })
+  await assert.rejects(provider.generateCoverage({ allTestsRun: false }), /Executed source is missing for subprocess coverage/)
+})
+
+test('native collection retains deleted executed source and its uncovered function', async (t) => {
+  const source = 'export function value() { return 17; }\nexport function uncalled() { return 23; }'
+  const { provider, filename } = await project(t, source, false)
+  await startCollection(t, filename)
+  const loaded = await import(pathToFileURL(filename).href)
+  assert.equal(loaded.value(), 17)
+  await rm(filename)
+  const { report, coverage } = await collect(provider, filename)
+  assert.deepEqual(coverage.files(), [filename])
+  const result = coverage.fileCoverageFor(filename)
+  const raw = JSON.parse(await readFile(report, 'utf8'))
+  const executed = raw.result.find(entry => entry.url === pathToFileURL(filename).href)
+  assert.notEqual(executed.executedSource.code, source)
+  assert.deepEqual(executed.executedSource.map.sourcesContent, [source])
+  assert.equal(executed.executedSource.scriptId, executed.scriptId)
+  assert.equal(typeof executed.executedSource.identity, 'string')
+  assert.deepEqual(Object.values(result.fnMap).map(fn => fn.name).sort(), ['uncalled', 'value'])
+  assert.equal(result.toSummary().functions.total, 2)
+  assert.equal(result.toSummary().functions.covered, 1)
+  assert.ok(result.getUncoveredLines().includes(2))
+})
+
+test('different generated bodies at one URL retain their own offsets before merging', async (t) => {
+  const first = 'function left(value) { if (value) return 11; return 12; }\nleft(true);'
+  const second = '\n\nfunction right(value) { if (value) return 21; return 22; }\nright(false);'
+  const { provider, filename } = await project(t, first, false)
+  await startCollection(t, filename)
+  const url = pathToFileURL(filename).href
+  assert.equal(new Script(first, { filename: url }).runInNewContext(), 11)
+  assert.equal(new Script(second, { filename: url }).runInNewContext(), 22)
+  await rm(filename)
+  const { report, coverage } = await collect(provider, filename)
+  const raw = JSON.parse(await readFile(report, 'utf8'))
+  const executed = raw.result.filter(entry => entry.url === url)
+  assert.equal(executed.length, 2)
+  assert.notEqual(executed[0].executedSource.identity, executed[1].executedSource.identity)
+  const result = coverage.fileCoverageFor(filename)
+  assert.deepEqual(Object.values(result.fnMap).map(fn => [fn.name, fn.loc.start.line]).sort(), [['left', 1], ['right', 3]])
+  assert.equal(result.toSummary().functions.total, 2)
+  assert.equal(result.toSummary().functions.covered, 2)
+  assert.equal(result.toSummary().branches.total, 4)
+  assert.equal(result.toSummary().branches.covered, 2)
+})
+
+test('external maps and original Unicode CRLF source survive deletion before collection', async (t) => {
+  const original = [
+    'function value(enabled) {',
+    '  if (enabled) {',
+    '    return "🚀";',
+    '  } else {',
+    '    return "🌙";',
+    '  }',
+    '}',
+    'value(false);',
+  ].join('\r\n')
+  const generated = `\r\n\r\n${original}\r\n//# sourceMappingURL=payload.js.map`
+  const { provider, filename } = await project(t, generated, false)
+  const authored = join(dirname(filename), 'authored.js')
+  await writeFile(authored, original)
+  await writeFile(`${filename}.map`, JSON.stringify({
+    version: 3,
+    sources: ['authored.js'],
+    names: [],
+    mappings: ';;AAAA;AACA;AACA;AACA;AACA;AACA;AACA;AACA',
+  }))
+  await startCollection(t, filename)
+  assert.equal(new Script(generated, { filename: pathToFileURL(filename).href }).runInNewContext(), '🌙')
+  await rm(filename)
+  await rm(`${filename}.map`)
+  await rm(authored)
+  const { report, coverage } = await collect(provider, filename)
+  assert.deepEqual(coverage.files(), [authored])
+  const result = coverage.fileCoverageFor(authored)
+  assert.equal(result.toSummary().functions.total, 1)
+  assert.equal(result.toSummary().functions.covered, 1)
+  assert.equal(result.getLineCoverage()[3], 0)
+  assert.equal(result.getLineCoverage()[5], 1)
+  const raw = JSON.parse(await readFile(report, 'utf8'))
+  const executed = raw.result.find(entry => entry.url === pathToFileURL(filename).href)
+  assert.equal(executed.executedSource.code, generated)
+  assert.deepEqual(executed.executedSource.map.sourcesContent, [original])
+})
+
+test('malformed executed source maps reject collection', async (t) => {
+  const generated = '17;\n//# sourceMappingURL=data:application/json,%7Binvalid'
+  const { filename } = await project(t, generated, false)
+  await startCollection(t, filename)
+  assert.equal(new Script(generated, { filename: pathToFileURL(filename).href }).runInNewContext(), 17)
+  await assert.rejects(collector.takeCoverage({ coverageFilesDirectory: dirname(filename) }), SyntaxError)
+})
+
+test('a serialized source mismatch rejects coverage before remapping', async (t) => {
+  const source = 'function value() { return 17; }\nvalue();'
+  const { provider, filename } = await project(t, source, false)
+  await startCollection(t, filename)
+  assert.equal(new Script(source, { filename: pathToFileURL(filename).href }).runInNewContext(), 17)
+  const report = await collector.takeCoverage({ coverageFilesDirectory: dirname(filename) })
+  const raw = JSON.parse(await readFile(report, 'utf8'))
+  const executed = raw.result.find(entry => entry.url === pathToFileURL(filename).href)
+  assert.ok(executed)
+  executed.executedSource.code += '\n19;'
+  await writeFile(report, JSON.stringify(raw))
+  provider.onAfterSuiteRun({ coverage: report, environment: 'ssr', projectName: '', testFiles: [filename] })
+  await assert.rejects(provider.generateCoverage({ allTestsRun: false }), /Executed source identity disagrees/)
+})
+
+test('coverage collection can restart after an isolated session is closed', async (t) => {
+  const { filename } = await project(t, '17;', false)
+  await collector.startCoverage({ isolate: true, autoAttachSubprocess: false, reportsDirectory: dirname(filename) })
+  const first = collector.session
+  assert.ok(first)
+  assert.equal(first.listenerCount('Debugger.scriptParsed'), 1)
+  await collector.stopCoverage({ isolate: true })
+  assert.equal(first.listenerCount('Debugger.scriptParsed'), 0)
+  await collector.startCoverage({ isolate: false, autoAttachSubprocess: false, reportsDirectory: dirname(filename) })
+  t.after(() => collector.stopCoverage({ isolate: true }))
+  assert.notEqual(collector.session, first)
+  assert.equal(new Script('17;', { filename: pathToFileURL(filename).href }).runInNewContext(), 17)
+  const report = await collector.takeCoverage({ coverageFilesDirectory: dirname(filename) })
+  const raw = JSON.parse(await readFile(report, 'utf8'))
+  assert.ok(raw.result.some(entry => entry.url === pathToFileURL(filename).href && entry.executedSource.code === '17;'))
+})
