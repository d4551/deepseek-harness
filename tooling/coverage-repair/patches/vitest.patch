+import assert from 'node:assert/strict'
+import { mkdtemp, realpath, rm, writeFile } from 'node:fs/promises'
+import { SourceMap } from 'node:module'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { test } from 'node:test'
+import { pathToFileURL } from 'node:url'
+import { Script } from 'node:vm'
+import { transformCode, initSyntaxLexers, collectModuleExports } from '../packages/mocker/src/node/parsers.ts'
+import { createVitest } from '../packages/vitest/src/public/node.ts'
+import { BaseCoverageProvider } from '../packages/vitest/src/node/coverage.ts'
+
+const source = [
+  'enum Mode { First = 3, Second = First + 1 }',
+  'class Box {',
+  '  constructor(public value: number) {}',
+  '  read() { return this.value; }',
+  '}',
+  'new Box(Mode.Second).read();',
+].join('\n')
+
+for (const extension of ['ts', 'mts', 'cts']) {
+  test(`module analysis transforms runtime TypeScript in .${extension}`, async () => {
+    const code = transformCode(source, `/project/payload.${extension}?test=1`)
+    assert.equal(new Script(code).runInNewContext(), 4)
+    const mutated = source.replace('new Box(Mode.Second)', 'Reflect.set(Mode, "Second", 9);\nnew Box(Mode.Second)')
+    assert.equal(new Script(transformCode(mutated, `/project/mutable.${extension}`)).runInNewContext(), 9)
+    await initSyntaxLexers()
+    const exported = transformCode('export enum Mode { First = 3 }\nexport class Box { constructor(public value: number) {} }', `/project/exports.${extension}`)
+    assert.deepEqual(collectModuleExports(`/project/exports.${extension}`, exported, 'module').sort(), ['Box', 'Mode'])
+  })
+}
+
+test('module analysis retains JavaScript bytes and rejects invalid TypeScript', () => {
+  const code = 'export const value = 17;'
+  assert.equal(transformCode(code, '/project/payload.js'), code)
+  assert.throws(() => transformCode('export const value: = 17;', '/project/payload.ts'))
+})
+
+test('unexecuted TypeScript coverage transforms enums and parameter properties with original positions', async (t) => {
+  const root = await realpath(await mkdtemp(join(tmpdir(), 'vitest-typescript-transform-')))
+  t.after(() => rm(root, { recursive: true, force: true }))
+  const filename = join(root, 'payload.ts')
+  await writeFile(filename, source)
+  const vitest = await createVitest({ root, config: false, watch: false,
+    experimental: { viteModuleRunner: false } })
+  t.after(() => vitest.close())
+  const provider = new BaseCoverageProvider()
+  const project = vitest.getRootProject()
+  const transformed = await provider.transformFile(`${pathToFileURL(filename).href}?test=1`, project, 'ssr')
+  assert.ok(transformed)
+  assert.ok(transformed.map)
+  assert.deepEqual(transformed.map.sources, [filename])
+  assert.deepEqual(transformed.map.sourcesContent, [source])
+  assert.deepEqual(JSON.parse(transformed.map.toString()).sourcesContent, [source])
+  assert.ok(transformed.map.toUrl().startsWith('data:application/json;charset=utf-8;base64,'))
+  assert.equal(new Script(transformed.code).runInNewContext(), 4)
+  const prefix = transformed.code.slice(0, transformed.code.indexOf('return this.value'))
+  assert.ok(transformed.code.includes('return this.value'))
+  const lines = prefix.split('\n')
+  const mapped = new SourceMap(transformed.map).findOrigin(lines.length, lines.at(-1).length + 1)
+  assert.equal(mapped.lineNumber, 4)
+  assert.equal(mapped.columnNumber, 12)
+
+  await writeFile(filename, 'const value: = 17;')
+  await assert.rejects(provider.transformFile(filename, project, 'ssr'))
+  await rm(filename)
+  await assert.rejects(provider.transformFile(filename, project, 'ssr'), { code: 'ENOENT' })
+})
