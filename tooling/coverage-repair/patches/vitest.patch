+import type { Debugger, InspectorNotification, Profiler } from 'node:inspector'
+import type { Session } from 'node:inspector/promises'
+import type { Options } from 'ast-v8-to-istanbul'
+import { Buffer } from 'node:buffer'
+import { createHash, randomUUID } from 'node:crypto'
+import { readFileSync } from 'node:fs'
+import { decodedMappings, encodedMap, TraceMap } from '@jridgewell/trace-mapping'
+
+export interface ExecutedSource {
+  sessionId: string
+  scriptId: string
+  url: string
+  code: string
+  map?: Options['sourceMap']
+  identity: string
+}
+
+function sourceIdentity(code: string, map: Options['sourceMap']): string {
+  return createHash('sha256').update(JSON.stringify([code, map])).digest('hex')
+}
+
+function readSourceMap(script: Debugger.ScriptParsedEventDataType): Options['sourceMap'] {
+  if (!script.sourceMapURL) return undefined
+  const url = new URL(script.sourceMapURL, script.url)
+  let content: string
+  if (url.protocol === 'data:') {
+    const comma = url.href.indexOf(',')
+    if (comma === -1) throw new Error(`Malformed source map URL for ${script.url}`)
+    const metadata = url.href.slice(0, comma)
+    const encoded = url.href.slice(comma + 1)
+    content = metadata.endsWith(';base64')
+      ? Buffer.from(encoded, 'base64').toString('utf8')
+      : decodeURIComponent(encoded)
+  }
+  else if (url.protocol === 'file:') {
+    content = readFileSync(url, 'utf8')
+  }
+  else {
+    throw new Error(`Source map for ${script.url} requires an unsupported URL: ${url.href}`)
+  }
+  const trace = new TraceMap(content, url.protocol === 'data:' ? script.url : url.href)
+  decodedMappings(trace)
+  const sourcesContent = trace.resolvedSources.map((source, index) => {
+    const embedded = trace.sourcesContent?.[index]
+    if (embedded !== undefined && embedded !== null) return embedded
+    return readFileSync(new URL(source), 'utf8')
+  })
+  return { ...encodedMap(trace), sources: trace.resolvedSources, sourcesContent, sourceRoot: undefined }
+}
+
+/** Owns the generated source and maps observed in one Inspector session. */
+export class ExecutedSources {
+  private readonly sessionId = randomUUID()
+  private readonly captures = new Map<string, Promise<PromiseSettledResult<ExecutedSource>[]>>()
+
+  constructor(private readonly session: Session) {}
+
+  private readonly onScriptParsed = ({ params }: InspectorNotification<Debugger.ScriptParsedEventDataType>): void => {
+    this.captures.set(params.scriptId, Promise.allSettled([this.capture(params)]))
+  }
+
+  private async capture(script: Debugger.ScriptParsedEventDataType): Promise<ExecutedSource> {
+    const map = readSourceMap(script)
+    const { scriptSource: code } = await this.session.post('Debugger.getScriptSource', { scriptId: script.scriptId })
+    if (script.length !== undefined && code.length !== script.length) {
+      throw new Error(`Executed source length disagrees with Inspector for ${script.url}`)
+    }
+    return { sessionId: this.sessionId, scriptId: script.scriptId, url: script.url, code, map, identity: sourceIdentity(code, map) }
+  }
+
+  async start(): Promise<void> {
+    this.session.on('Debugger.scriptParsed', this.onScriptParsed)
+    await this.session.post('Debugger.enable')
+  }
+
+  async get(scriptId: string, url: string): Promise<ExecutedSource> {
+    const capture = this.captures.get(scriptId)
+    if (!capture) throw new Error(`Executed source was not captured for ${url} (${scriptId})`)
+    const [result] = await capture
+    if (!result) throw new Error(`Executed source capture did not settle for ${url} (${scriptId})`)
+    if (result.status === 'rejected') throw result.reason
+    if (result.value.url !== url) throw new Error(`Executed source URL disagrees with coverage for ${url} (${scriptId})`)
+    return result.value
+  }
+
+  async stop(): Promise<void> {
+    this.session.off('Debugger.scriptParsed', this.onScriptParsed)
+    await Promise.all(this.captures.values())
+    await this.session.post('Debugger.disable')
+    this.captures.clear()
+  }
+}
+
+/** Verify serialized source identity and UTF-16 ranges before remapping. */
+export function validateExecutedSource(source: ExecutedSource, script: Profiler.ScriptCoverage): void {
+  if (source.scriptId !== script.scriptId || source.url !== script.url || !source.sessionId
+    || source.identity !== sourceIdentity(source.code, source.map)) {
+    throw new Error(`Executed source identity disagrees with coverage for ${script.url}`)
+  }
+  for (const fn of script.functions) {
+    for (const range of fn.ranges) {
+      if (!Number.isSafeInteger(range.startOffset) || !Number.isSafeInteger(range.endOffset)
+        || range.startOffset < 0 || range.endOffset < range.startOffset || range.endOffset > source.code.length) {
+        throw new Error(`Coverage offsets exceed the executed source for ${script.url}`)
+      }
+    }
+  }
+}
