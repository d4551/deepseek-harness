+use crate::check_peer_dependencies_of_importers;
+use pnpm_lockfile::Lockfile;
+use serde_json::json;
+
+fn check_linked_artifact(reference: &str, package_key: &str, version: &str) {
+    let directory = tempfile::tempdir().expect("create project directory");
+    let consumer = directory.path().join("consumer");
+    std::fs::create_dir(&consumer).expect("create consumer directory");
+    std::fs::write(
+        consumer.join("package.json"),
+        r#"{
+        "name": "consumer", "version": "1.0.0",
+        "peerDependencies": { "provider": "^4.8.1" }
+    }"#,
+    )
+    .expect("write linked consumer manifest");
+    let lockfile: Lockfile = serde_json::from_value(json!({
+        "lockfileVersion": "9.0",
+        "importers": { ".": { "dependencies": {
+            "consumer": { "specifier": "link:consumer", "version": "link:consumer" },
+            "provider": { "specifier": reference, "version": reference }
+        } } },
+        "packages": { (package_key): {
+            "resolution": { "tarball": "file:provider.tgz" }, "version": version
+        } },
+        "snapshots": { (package_key): {} }
+    }))
+    .expect("parse linked project lockfile");
+    let issues =
+        check_peer_dependencies_of_importers(&lockfile, directory.path(), &[".".to_owned()], None)
+            .expect("inspect linked peers");
+    let result = &issues["."];
+    assert_eq!(result.missing.len(), 0, "{result:?}");
+    if version == "4.23.13" {
+        assert_eq!(result.bad.len(), 0, "{result:?}");
+    } else {
+        assert_eq!(result.bad.len(), 1, "{result:?}");
+        assert_eq!(result.bad["provider"].len(), 1);
+        assert_eq!(result.bad["provider"][0].found_version, version);
+        assert_eq!(result.bad["provider"][0].wanted_range, "^4.8.1");
+    }
+}
+
+#[test]
+fn linked_consumer_accepts_local_archive() {
+    check_linked_artifact("file:provider.tgz", "provider@file:provider.tgz", "4.23.13");
+}
+
+#[test]
+fn linked_consumer_accepts_aliased_archive() {
+    check_linked_artifact("actual@file:provider.tgz", "actual@file:provider.tgz", "4.23.13");
+}
+
+#[test]
+fn linked_consumer_accepts_remote_archive() {
+    check_linked_artifact(
+        "https://example.com/provider.tgz",
+        "provider@https://example.com/provider.tgz",
+        "4.23.13",
+    );
+}
+
+#[test]
+fn linked_consumer_rejects_incompatible_archive_version() {
+    check_linked_artifact("actual@file:provider.tgz", "actual@file:provider.tgz", "3.9.0");
+}
