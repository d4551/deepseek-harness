+use crate::check_peer_dependencies_of_importers;
+use pnpm_lockfile::Lockfile;
+use serde_json::json;
+
+fn check_artifact_version(reference: &str, package_key: &str, version: Option<&str>) {
+    let directory = tempfile::tempdir().expect("create lockfile directory");
+    let lockfile: Lockfile = serde_json::from_value(json!({
+        "lockfileVersion": "9.0",
+        "importers": { ".": { "dependencies": {
+            "consumer": { "specifier": "1.0.0", "version": "1.0.0" }
+        } } },
+        "packages": {
+            "consumer@1.0.0": {
+                "resolution": { "integrity": "sha512-AAAA" },
+                "peerDependencies": { "provider": "^4.8.1" }
+            },
+            (package_key): {
+                "resolution": { "tarball": "file:provider.tgz" },
+                "version": version
+            }
+        },
+        "snapshots": {
+            "consumer@1.0.0": { "dependencies": { "provider": reference } },
+            (package_key): {}
+        }
+    }))
+    .expect("parse artifact lockfile");
+    let issues =
+        check_peer_dependencies_of_importers(&lockfile, directory.path(), &[".".to_owned()], None)
+            .expect("inspect peer dependencies");
+    let result = &issues["."];
+    if version == Some("4.23.13") {
+        assert_eq!(result.bad.len(), 0, "{result:?}");
+    } else {
+        assert_eq!(result.bad.len(), 1, "{result:?}");
+        let issue = &result.bad["provider"][0];
+        assert_eq!(issue.wanted_range, "^4.8.1");
+        if let Some(version) = version {
+            assert_eq!(issue.found_version, version);
+        }
+    }
+    assert_eq!(result.missing.len(), 0, "{result:?}");
+}
+
+#[test]
+fn local_archive_uses_declared_version() {
+    check_artifact_version("file:provider.tgz", "provider@file:provider.tgz", Some("4.23.13"));
+}
+
+#[test]
+fn local_archive_outside_peer_range_is_rejected() {
+    check_artifact_version("file:provider.tgz", "provider@file:provider.tgz", Some("3.9.0"));
+}
+
+#[test]
+fn local_archive_without_declared_version_is_rejected() {
+    check_artifact_version("file:provider.tgz", "provider@file:provider.tgz", None);
+}
+
+#[test]
+fn aliased_archive_uses_target_metadata() {
+    check_artifact_version("actual@file:provider.tgz", "actual@file:provider.tgz", Some("4.23.13"));
+}
+
+#[test]
+fn peer_suffixed_archive_uses_base_metadata() {
+    check_artifact_version(
+        "file:provider.tgz(other@1.0.0)",
+        "provider@file:provider.tgz",
+        Some("4.23.13"),
+    );
+}
+
+#[test]
+fn remote_archive_uses_declared_version() {
+    check_artifact_version(
+        "https://example.com/provider.tgz",
+        "provider@https://example.com/provider.tgz",
+        Some("4.23.13"),
+    );
+}
+
+#[test]
+fn registry_version_is_checked_without_metadata_version() {
+    check_artifact_version("3.9.0", "provider@3.9.0", None);
+}
