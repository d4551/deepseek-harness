+
+for (const container of [
+  {
+    name: "object method",
+    opening: "const holder = { method() {\n",
+    closing: "\n} };\n",
+    call: "holder.method()",
+  },
+  {
+    name: "arrow function",
+    opening: "const holder = () => {\n",
+    closing: "\n};\n",
+    call: "holder()",
+  },
+  {
+    name: "function expression",
+    opening: "const holder = function() {\n",
+    closing: "\n};\n",
+    call: "holder()",
+  },
