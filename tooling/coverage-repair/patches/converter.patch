+import type { Node } from "estree";
+import { walk } from "estree-walker";
+
+const functionTypes = new Set([
+  "ArrowFunctionExpression",
+  "FunctionExpression",
+  "FunctionDeclaration",
+  "MethodDefinition",
+  "ClassMethod",
+  "ClassPrivateMethod",
+  "ObjectMethod",
+]);
+
+export function getDeferredFunctionRanges(node: Node) {
+  const ranges: Pick<Node, "start" | "end">[] = [];
+  walk(node, {
+    enter(current) {
+      if (!functionTypes.has(current.type)) return;
+      let start = current.start;
+      if ("computed" in current && current.computed && "key" in current) {
+        start = current.key.end;
+      }
+      ranges.push({ start, end: current.end });
+      this.skip();
+    },
+  });
+  return ranges;
+}
