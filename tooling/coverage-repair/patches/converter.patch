+import { randomUUID } from "node:crypto";
+import { Session } from "node:inspector/promises";
+import { resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+import { Script } from "node:vm";
+import { TraceMap } from "@jridgewell/trace-mapping";
+import { createCoverageMap } from "@vitest/istanbul-lib-coverage";
+import MagicString from "magic-string";
+import { expect, onTestFinished, test } from "vitest";
+import convert from "../src";
+import { Locator } from "../src/location";
+import { parse } from "./utils";
+
+test.each(["function Run() ", "const Run = () => "])(
+  "native coverage locates a generated declaration: %s",
+  async (declaration) => {
+    const filename = resolve(import.meta.dirname, `declaration-${randomUUID()}.js`);
+    const url = pathToFileURL(filename).href;
+    const generated = new MagicString("{ return 7; }", { filename })
+      .prepend(`function Unrelated() { return 11; } ${declaration}`)
+      .append(";\nRun();");
+    const code = generated.toString();
+    const session = new Session();
+    session.connect();
+    onTestFinished(() => session.disconnect());
+    await session.post("Profiler.enable");
+    await session.post("Profiler.startPreciseCoverage", { callCount: true, detailed: true });
+    expect(new Script(code, { filename: url }).runInNewContext()).toBe(7);
+    const measured = await session.post("Profiler.takePreciseCoverage");
+    await session.post("Profiler.stopPreciseCoverage");
+    const records = measured.result.filter((record) => record.url === url);
+    expect(records).toHaveLength(1);
+    const coverage = createCoverageMap(
+      await convert({
+        code,
+        ast: parse(code),
+        sourceMap: generated.generateMap({ hires: true, source: filename, includeContent: true }),
+        coverage: records[0],
+      }),
+    ).fileCoverageFor(filename);
+
+    expect(Object.values(coverage.f)).toEqual([1]);
+    expect(Object.values(coverage.fnMap).map((entry) => entry.decl)).toEqual([
+      { start: { line: 1, column: 0 }, end: { line: 1, column: 1 } },
+    ]);
+    expect(Object.values(coverage.fnMap).map((entry) => entry.loc.start)).toEqual([
+      { line: 1, column: 0 },
+    ]);
+  },
+);
+
+test("a declaration cannot borrow a mapped position after its owning function", () => {
+  const code = "function First() { return 1; } function Second() { return 2; }";
+  const next = code.indexOf("function Second");
+  const locator = new Locator(
+    code,
+    new TraceMap({
+      version: 3,
+      names: [],
+      sources: ["authored.js"],
+      sourcesContent: ["function Second() { return 2; }"],
+      mappings: [[[0], [next, 0, 0, 0], [next + 9, 0, 0, 9]]],
+    }),
+    "",
+  );
+  const start = code.indexOf("First");
+  expect(locator.getDeclarationLoc({ start, end: start + 5 }, { start: 0, end: next })).toBeNull();
+});
