+assert.equal(Object.keys(fixture).length, 1000);
+for (let condition = 1; condition <= 5; condition++) {
+  const method = fixture[`method${condition}`];
+  assert.equal(typeof method, "function");
+  assert.equal(method(condition), 0);
+}
+
+const collected = await session.post("Profiler.takePreciseCoverage");
+await session.post("Profiler.stopPreciseCoverage");
+const records = collected.result.filter((record) => record.url === url);
+assert.equal(records.length, 1);
+const [coverage] = records;
+const executed = await session.post("Debugger.getScriptSource", { scriptId: coverage.scriptId });
+assert.equal(executed.scriptSource, source);
+console.log(JSON.stringify({ source, ...coverage }));
