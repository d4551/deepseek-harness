+import assert from "node:assert/strict";
+import { execFile } from "node:child_process";
+import { mkdtempDisposable, writeFile } from "node:fs/promises";
+import type { Profiler } from "node:inspector";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { promisify } from "node:util";
+
+const execute = promisify(execFile);
+
+export async function collectFunctions(code: string): Promise<Profiler.FunctionCoverage[]> {
+  await using directory = await mkdtempDisposable(join(tmpdir(), "ast-v8-e2e-"));
+  const filename = join(directory.path, "functions.mjs");
+  await writeFile(filename, code);
+  const collector = fileURLToPath(new URL("./e2e-native-coverage.ts", import.meta.url));
+  const { stdout, stderr } = await execute(process.execPath, [collector, filename]);
+  assert.equal(stderr, "");
+  const record: unknown = JSON.parse(stdout);
+  assert.ok(record !== null && typeof record === "object");
+  assert.ok("source" in record && record.source === code);
+  assert.ok("functions" in record && Array.isArray(record.functions));
+
+  const functions = record.functions.map((entry: unknown): Profiler.FunctionCoverage => {
+    assert.ok(entry !== null && typeof entry === "object");
+    assert.ok("functionName" in entry && typeof entry.functionName === "string");
+    assert.ok("isBlockCoverage" in entry && typeof entry.isBlockCoverage === "boolean");
+    assert.ok("ranges" in entry && Array.isArray(entry.ranges) && entry.ranges.length > 0);
+
+    const ranges = entry.ranges.map((range: unknown): Profiler.CoverageRange => {
+      assert.ok(range !== null && typeof range === "object");
+      assert.ok("startOffset" in range && typeof range.startOffset === "number");
+      assert.ok("endOffset" in range && typeof range.endOffset === "number");
+      assert.ok("count" in range && typeof range.count === "number");
+      const { startOffset, endOffset, count } = range;
+      assert.ok(Number.isSafeInteger(startOffset) && startOffset >= 0);
+      assert.ok(Number.isSafeInteger(endOffset) && endOffset > startOffset);
+      assert.ok(endOffset <= code.length);
+      assert.ok(Number.isSafeInteger(count) && count >= 0);
+      return { startOffset, endOffset, count };
+    });
+
+    return { functionName: entry.functionName, isBlockCoverage: entry.isBlockCoverage, ranges };
+  });
+
+  const methods = functions.filter((entry) => entry.functionName.startsWith("method"));
+  assert.equal(methods.length, 1000);
+  for (let index = 1; index <= 1000; index++) {
+    const method = methods.find((entry) => entry.functionName === `method${index}`);
+    assert.ok(method);
+    assert.equal(method.ranges[0].count, index <= 5 ? 1 : 0);
+    assert.ok(code.slice(method.ranges[0].startOffset).startsWith(`function method${index}(`));
+  }
+  return functions;
+}
