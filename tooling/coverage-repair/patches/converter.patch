+  test.each([false, true])(
+    `creating a generated ${container.name} keeps deferred body counts independent: %s`,
+    async (called) => {
+      const filename = resolve(import.meta.dirname, `evaluation-${randomUUID()}.js`);
+      const url = pathToFileURL(filename).href;
+      const generated = new MagicString("const value = 7;\nreturn value;", { filename })
+        .prepend(container.opening)
+        .append(`${container.closing}${called ? container.call : "13"};`);
+      const code = generated.toString();
+      const session = new Session();
+      session.connect();
+      onTestFinished(() => session.disconnect());
+      await session.post("Profiler.enable");
+      await session.post("Profiler.startPreciseCoverage", { callCount: true, detailed: true });
+      expect(new Script(code, { filename: url }).runInNewContext()).toBe(called ? 7 : 13);
+      const measured = await session.post("Profiler.takePreciseCoverage");
+      await session.post("Profiler.stopPreciseCoverage");
+      const records = measured.result.filter((record) => record.url === url);
+      expect(records).toHaveLength(1);
+      const coverage = createCoverageMap(
+        await convert({
+          code,
+          ast: parse(code),
+          sourceMap: generated.generateMap({ hires: true, source: filename, includeContent: true }),
+          coverage: records[0],
+        }),
+      ).fileCoverageFor(filename);
+
+      expect(Object.values(coverage.statementMap)).toEqual([
+        { start: { line: 1, column: 14 }, end: { line: 1, column: 15 } },
+        { start: { line: 2, column: 0 }, end: { line: 2, column: Infinity } },
