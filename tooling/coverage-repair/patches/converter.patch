+++ b/checks/location-integrity.mjs
@@ -0,0 +1,67 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { TraceMap } from "@jridgewell/trace-mapping";
+import { Locator } from "../src/location.ts";
+
+await test("an explicitly unmapped prefix does not borrow the following original position", () => {
+  const code = " generated(); authored();";
+  const map = new TraceMap({
+    version: 3,
+    names: [],
+    sources: ["authored.js"],
+    sourcesContent: ["authored();"],
+    mappings: [[[0], [code.indexOf("authored"), 0, 0, 0]]],
+  });
+  const locator = new Locator(code, map, "");
+  assert.equal(
+    locator.getLoc({ start: code.indexOf("generated"), end: code.indexOf("authored") }),
+    null,
+  );
+  const authored = locator.getLoc({ start: code.indexOf("authored"), end: code.length });
+  assert.ok(authored);
+  assert.deepEqual(authored.start, { filename: "authored.js", line: 1, column: 0 });
+});
+
+await test("an explicitly unmapped middle segment does not acquire its next statement", () => {
+  const code = "first(); generated(); second();";
+  const map = new TraceMap({
+    version: 3,
+    names: [],
+    sources: ["authored.js"],
+    sourcesContent: ["first();\nsecond();"],
+    mappings: [[[0, 0, 0, 0], [code.indexOf("generated") - 1], [code.indexOf("second"), 0, 1, 0]]],
+  });
+  const locator = new Locator(code, map, "");
+  assert.equal(
+    locator.getLoc({ start: code.indexOf("generated"), end: code.indexOf("second") }),
+    null,
+  );
+  assert.deepEqual(locator.getLoc({ start: 0, end: 8 })?.start, {
+    filename: "authored.js",
+    line: 1,
+    column: 0,
+  });
+  assert.deepEqual(locator.getLoc({ start: code.indexOf("second"), end: code.length })?.start, {
+    filename: "authored.js",
+    line: 2,
+    column: 0,
+  });
+});
+
+await test("a prefix before the first mapping has no original position", () => {
+  const code = "generated(); authored();";
+  const map = new TraceMap({
+    version: 3,
+    names: [],
+    sources: ["authored.js"],
+    sourcesContent: ["authored();"],
+    mappings: [[[code.indexOf("authored"), 0, 0, 0]]],
+  });
+  const locator = new Locator(code, map, "");
+  assert.equal(locator.getLoc({ start: 0, end: code.indexOf("authored") }), null);
+  assert.deepEqual(locator.getLoc({ start: code.indexOf("authored"), end: code.length })?.start, {
+    filename: "authored.js",
+    line: 1,
+    column: 0,
+  });
+});
