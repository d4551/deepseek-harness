--- /dev/null
+++ b/internal/sourcemap/unmapped_test.go
@@ -0,0 +1,61 @@
+package sourcemap
+
+import (
+	"testing"
+
+	"github.com/evanw/esbuild/internal/ast"
+	"github.com/evanw/esbuild/internal/helpers"
+	"github.com/evanw/esbuild/internal/logger"
+)
+
+func TestGeneratedLocations(t *testing.T) {
+	b := MakeChunkBuilder(nil, GenerateLineOffsetTables("value\nsecond", 2), false)
+	b.AddSourceMapping(logger.Loc{Start: -1}, "", nil)
+	b.AddSourceMapping(logger.Loc{Start: -1}, "", []byte("helper"))
+	b.AddSourceMapping(logger.Loc{Start: 0}, "value", []byte("helper;"))
+	b.AddSourceMapping(logger.Loc{Start: -1}, "", []byte("helper;value;"))
+	b.AddSourceMapping(logger.Loc{Start: 6}, "second", []byte("helper;value;generated\nmore\n"))
+	chunk := b.GenerateChunk([]byte("helper;value;generated\nmore\nsecond"))
+	if actual := string(chunk.Buffer.Data); actual != "A,OAAAA,M;;AACAC" {
+		t.Fatalf("mappings = %q", actual)
+	}
+	if chunk.ShouldIgnore || chunk.EndState.OriginalLine != 1 || chunk.FinalGeneratedColumn != 6 {
+		t.Fatalf("chunk = %+v", chunk)
+	}
+}
+
+func TestEntirelyGeneratedChunk(t *testing.T) {
+	b := MakeChunkBuilder(nil, nil, false)
+	b.AddSourceMapping(logger.Loc{Start: -1}, "", nil)
+	chunk := b.GenerateChunk([]byte("generated\nmore"))
+	if string(chunk.Buffer.Data) != "A;" || !chunk.ShouldIgnore {
+		t.Fatalf("chunk = %+v", chunk)
+	}
+}
+
+func TestAppendChunkLeadingUnmapped(t *testing.T) {
+	previous := SourceMapState{GeneratedColumn: 4, SourceIndex: 3, OriginalLine: 5, OriginalColumn: 7, OriginalName: 2}
+	start := SourceMapState{GeneratedColumn: 10, SourceIndex: 8, OriginalName: 6}
+	for _, test := range []struct {
+		name       string
+		data       string
+		nameOffset ast.Index32
+		expected   string
+	}{
+		{"mapped", "AAAAA", ast.MakeIndex32(4), "MKLPI"},
+		{"unmapped", "A", ast.Index32{}, "M"},
+		{"same-line", "A,KAAAA", ast.MakeIndex32(6), "M,KKLPI"},
+		{"later-line", "A;AAAAA", ast.MakeIndex32(6), "M;AKLPI"},
+		{"several-unmapped", "A,C;;A,EAAAA", ast.MakeIndex32(11), "M,C;;A,EKLPI"},
+		{"no-name", "A;AAAA", ast.Index32{}, "M;AKLP"},
+		{"leading-lines", ";;A;AAAAA", ast.MakeIndex32(8), ";;A;AKLPI"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			var j helpers.Joiner
+			AppendSourceMapChunk(&j, previous, start, MappingsBuffer{Data: []byte(test.data), FirstNameOffset: test.nameOffset})
+			if actual := string(j.Done()); actual != test.expected {
+				t.Fatalf("mappings = %q, want %q", actual, test.expected)
+			}
+		})
+	}
+}
