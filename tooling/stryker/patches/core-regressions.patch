+++ b/test/integration/reporter-registry/verify.mjs
@@ -0,0 +1,26 @@
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { writeFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+const compiler = fileURLToPath(new URL('./bin/tsc', import.meta.resolve('typescript/package.json')));
+for (const [kind, expectedStatus] of [['positive', 0], ['negative', 1]]) {
+  const result = spawnSync(process.execPath, [compiler, '-p', `tsconfig.${kind}.json`, '--pretty', 'false'], { encoding: 'utf8' });
+  writeFileSync(`${kind}-types.log`, result.stdout + result.stderr);
+  assert.equal(result.error, undefined);
+  assert.equal(result.signal, null);
+  assert.equal(result.status, expectedStatus, result.stdout + result.stderr);
+  assert.equal(result.stderr, '');
+  if (expectedStatus === 0) assert.equal(result.stdout, '');
+  else {
+    const errors = result.stdout.split('\n').filter(line => /error TS\d+:/.test(line));
+    assert.equal(errors.length, 1, result.stdout);
+    assert.ok(errors[0].startsWith('negative.ts(5,47): error TS2345:'), result.stdout);
+  }
+}
+const execution = spawnSync(process.execPath, ['positive.ts'], { encoding: 'utf8' });
+writeFileSync('positive-runtime.log', execution.stdout + execution.stderr);
+assert.equal(execution.error, undefined);
+assert.equal(execution.signal, null);
+assert.equal(execution.status, 0, execution.stdout + execution.stderr);
+assert.equal(execution.stderr, '');
+console.log('Positive real DI consumer compiles and executes; empty injector rejects at the exact call with no extra diagnostics.');
