diff --git a/test/integration/tsconfig-jsonc.test.mjs b/test/integration/tsconfig-jsonc.test.mjs
new file mode 100644
--- /dev/null
+++ b/test/integration/tsconfig-jsonc.test.mjs
@@ -0,0 +1,147 @@
+import assert from 'node:assert/strict';
+import { mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { test } from 'node:test';
+import { TSConfigPreprocessor } from '../../dist/src/sandbox/ts-config-preprocessor.js';
+import { Project } from '../../dist/src/fs/project.js';
+import { FileSystem } from '../../dist/src/fs/file-system.js';
+import { LoggerImpl } from '../../dist/src/logging/logger-impl.js';
+import { LoggingBackend } from '../../dist/src/logging/logging-backend.js';
+
+const invalid = [
+  ['missing closing brace', '{"files": ["index.ts"]', /CloseBraceExpected/],
+  ['BOM followed by missing closing brace', '\uFEFF{"files": []', /CloseBraceExpected at offset 13, length 0/],
+  ['missing comma', '{"files": [] "include": []}', /CommaExpected/],
+  ['unfinished comment', '{"files": []} /* unfinished', /UnexpectedEndOfComment/],
+  ['additional root', '{} {}', /EndOfFileExpected/],
+  ['empty input', '', /ValueExpected/],
+  ['null root', 'null', /root must be an object/],
+  ['array root', '[]', /root must be an object/],
+  ['boolean root', 'false', /root must be an object/],
+  ['string root', '"config"', /root must be an object/],
+  ['invalid files', '{"files": [1]}', /files must be an array of strings/],
+  ['invalid include', '{"include": "src"}', /include must be an array of strings/],
+  ['invalid exclude', '{"exclude": [null]}', /exclude must be an array of strings/],
+  ['invalid extends', '{"extends": 1}', /extends must be a string or an array of strings/],
+  ['invalid extends member', '{"extends": ["base", 1]}', /extends must be a string or an array of strings/],
+  ['invalid references', '{"references": {"path":"base"}}', /references must be an array/],
+  ['invalid reference entry', '{"references": [null]}', /references\[0\] must be an object with a string path/],
+  ['invalid reference path', '{"references": [{"path":1}]}', /references\[0\] must be an object with a string path/],
+  ['missing reference path', '{"references": [{}]}', /references\[0\] must be an object with a string path/],
+  ['inherited reference path', '{"references": [{"__proto__":{"path":"base"}}]}', /references\[0\] must be an object with a string path/],
+  ['invalid compiler options', '{"compilerOptions": []}', /compilerOptions must be an object/],
+];
+
+for (const [name, content, diagnostic] of invalid) {
+  test(`rejects ${name} without rewriting the project`, async () => {
+    const directory = await mkdtemp(path.join(process.cwd(), '.jsonc-invalid-'));
+    const fileName = path.join(directory, 'tsconfig.json');
+    const fs = new FileSystem();
+    const logging = new LoggingBackend(process.stdout);
+    try {
+      await writeFile(fileName, content);
+      const project = new Project(fs, { [fileName]: { mutate: false } });
+      const preprocessor = new TSConfigPreprocessor(new LoggerImpl('jsonc-regression', logging), {
+        inPlace: false, tsconfigFile: fileName,
+      });
+      await assert.rejects(preprocessor.preprocess(project), error => {
+        assert.ok(error instanceof Error);
+        assert.ok(error.message.includes(fileName));
+        assert.match(error.message, diagnostic);
+        return true;
+      });
+      assert.equal(await project.files.get(fileName).readContent(), content);
+      assert.equal(await readFile(fileName, 'utf8'), content);
+    } finally {
+      fs.dispose();
+      await logging.dispose();
+      await rm(directory, { recursive: true, force: true });
+    }
+  });
+}
+
+test('preserves BOM, JSONC semantics, ordered multiple extends, project references, and unrelated fields', async () => {
+  const directory = await mkdtemp(path.join(process.cwd(), '.jsonc-valid-'));
+  const fileName = path.join(directory, 'tsconfig.json');
+  const baseName = path.join(directory, 'base.json');
+  const modelName = path.join(directory, 'model/tsconfig.json');
+  const fs = new FileSystem();
+  const logging = new LoggingBackend(process.stdout);
+  const content = `\uFEFF{
+    // Both TypeScript JSONC extensions are intentional.
+    "extends": ["./base.json", "../../../external/base.json",],
+    "references": [{"path":"./model", "prepend":false}, {"path":"../../../external/model"},],
+    "files": ["local.ts", "../../outside.ts",],
+    "include": ["src/**", "../../outside/**"],
+    "exclude": ["build", "../../excluded/**"],
+    "compilerOptions": {"strict":true, "paths":{"pkg":["./pkg"]},},
+    "watchOptions": {"watchFile":"useFsEvents"},
+    "__proto__": {"retained":true, "files":[1]},
+  }`;
+  const base = '{"extends":"./tsconfig.json", "compilerOptions":{"target":"esnext"}}';
+  const model = '{"files":["../../../external/model.ts"], "references":[]}';
+  try {
+    await mkdir(path.dirname(modelName));
+    await writeFile(fileName, content);
+    await writeFile(baseName, base);
+    await writeFile(modelName, model);
+    const project = new Project(fs, Object.fromEntries(
+      [fileName, baseName, modelName].map(name => [name, { mutate: false }]),
+    ));
+    await new TSConfigPreprocessor(new LoggerImpl('jsonc-regression', logging), {
+      inPlace: false, tsconfigFile: fileName,
+    }).preprocess(project);
+    assert.deepEqual(JSON.parse(await project.files.get(fileName).readContent()), JSON.parse(`{
+      "extends":["./base.json", "../../../../../external/base.json"],
+      "references":[{"path":"./model", "prepend":false}, {"path":"../../../../../external/model/tsconfig.json"}],
+      "files":["local.ts", "../../../../outside.ts"],
+      "include":["src/**", "../../../../outside/**"],
+      "exclude":["build", "../../../../excluded/**"],
+      "compilerOptions":{"strict":true, "paths":{"pkg":["./pkg"]}},
+      "watchOptions":{"watchFile":"useFsEvents"},
+      "__proto__":{"retained":true, "files":[1]}
+    }`));
+    assert.deepEqual(JSON.parse(await project.files.get(baseName).readContent()), JSON.parse(base));
+    assert.deepEqual(JSON.parse(await project.files.get(modelName).readContent()), {
+      files: ['../../../../../external/model.ts'], references: [],
+    });
+    assert.equal(await readFile(fileName, 'utf8'), content);
+    assert.equal(await readFile(baseName, 'utf8'), base);
+    assert.equal(await readFile(modelName, 'utf8'), model);
+  } finally {
+    fs.dispose();
+    await logging.dispose();
+    await rm(directory, { recursive: true, force: true });
+  }
+});
+
+test('rejects a malformed referenced config with its own source location', async () => {
+  const directory = await mkdtemp(path.join(process.cwd(), '.jsonc-reference-'));
+  const fileName = path.join(directory, 'tsconfig.json');
+  const referenceName = path.join(directory, 'model.json');
+  const fs = new FileSystem();
+  const logging = new LoggingBackend(process.stdout);
+  const content = '{"references":[{"path":"./model.json"}]}';
+  const malformed = '{"files": []';
+  try {
+    await writeFile(fileName, content);
+    await writeFile(referenceName, malformed);
+    const project = new Project(fs, {
+      [fileName]: { mutate: false }, [referenceName]: { mutate: false },
+    });
+    await assert.rejects(new TSConfigPreprocessor(new LoggerImpl('jsonc-regression', logging), {
+      inPlace: false, tsconfigFile: fileName,
+    }).preprocess(project), error => {
+      assert.ok(error instanceof Error);
+      assert.ok(error.message.includes(referenceName));
+      assert.match(error.message, /CloseBraceExpected at offset 12, length 0/);
+      return true;
+    });
+    assert.equal(await project.files.get(fileName).readContent(), content);
+    assert.equal(await project.files.get(referenceName).readContent(), malformed);
+  } finally {
+    fs.dispose();
+    await logging.dispose();
+    await rm(directory, { recursive: true, force: true });
+  }
+});
