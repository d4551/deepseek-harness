diff --git a/test/integration/child-timeout/verify.mjs b/test/integration/child-timeout/verify.mjs
new file mode 100644
--- /dev/null
+++ b/test/integration/child-timeout/verify.mjs
@@ -0,0 +1,38 @@
+import assert from 'node:assert/strict'
+import { spawnSync } from 'node:child_process'
+import { readFileSync, writeFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+
+const directory = fileURLToPath(new URL('.', import.meta.url))
+const ownershipLog = fileURLToPath(new URL('./owners.jsonl', import.meta.url))
+writeFileSync(ownershipLog, '')
+const environment = { ...process.env, DSH_RUNNER_OWNERSHIP_LOG: ownershipLog }
+try {
+  const run = spawnSync(process.execPath, [fileURLToPath(new URL('../../../bin/stryker.js', import.meta.url)), 'run'], {
+    cwd: directory, env: environment, encoding: 'utf8', timeout: 60000,
+  })
+  writeFileSync(new URL('./stryker.log', import.meta.url), `${run.stdout}${run.stderr}`)
+  assert.equal(run.error, undefined)
+  assert.equal(run.status, 0)
+  const report = JSON.parse(readFileSync(new URL('./reports/mutation.json', import.meta.url), 'utf8'))
+  const mutants = Object.values(report.files).flatMap(file => file.mutants)
+  assert.equal(mutants.length, 4)
+  assert.equal(mutants.filter(mutant => mutant.status === 'Timeout').length, 2)
+  assert.equal(mutants.filter(mutant => mutant.status === 'Killed').length, 2)
+  const owners = readFileSync(ownershipLog, 'utf8').trim().split('\n').map(line => JSON.parse(line))
+  for (const pid of new Set(owners.flatMap(owner => [owner.child, owner.worker]))) {
+    assert.throws(() => process.kill(pid, 0), { code: 'ESRCH' }, `owned process ${pid} must be gone after mutation`)
+  }
+  const baseline = spawnSync(process.execPath, [fileURLToPath(new URL('../../../../../node_modules/vitest/vitest.mjs', import.meta.url)), 'run', '--config', 'vitest.config.mjs'], {
+    cwd: directory, env: environment, encoding: 'utf8', timeout: 30000,
+  })
+  writeFileSync(new URL('./baseline.log', import.meta.url), `${baseline.stdout}${baseline.stderr}`)
+  assert.equal(baseline.error, undefined)
+  assert.equal(baseline.status, 0)
+  console.log('All four mutations classified; timed-out child and worker owners are gone; subsequent original baseline passes.')
+} finally {
+  const owners = readFileSync(ownershipLog, 'utf8').trim().split('\n').filter(Boolean).map(line => JSON.parse(line))
+  for (const pid of new Set(owners.flatMap(owner => [owner.child, owner.worker]))) {
+    if (spawnSync('kill', ['-0', String(pid)]).status === 0) process.kill(pid, 'SIGKILL')
+  }
+}
