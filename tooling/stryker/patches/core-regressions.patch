+import assert from 'node:assert/strict';
+import { createInjector } from 'typed-inject';
+import { strykerPlugins } from '../../../dist/src/reporters/index.js';
+import { ClearTextReporter } from '../../../dist/src/reporters/clear-text-reporter.js';
+import { HtmlReporter } from '../../../dist/src/reporters/html-reporter.js';
+import { JsonReporter } from '../../../dist/src/reporters/json-reporter.js';
+import { LoggingBackend } from '../../../dist/src/logging/logging-backend.js';
+import { LoggerImpl } from '../../../dist/src/logging/logger-impl.js';
+import { createDefaultOptions } from '../../../dist/src/config/options-validator.js';
+const backend = new LoggingBackend(process.stdout);
+const logger = new LoggerImpl('registry-consumer', backend);
+const injector = createInjector().provideValue('logger', logger).provideValue('options', createDefaultOptions());
+try {
+  assert.equal(strykerPlugins.length, 8);
+  assert.ok('inject' in strykerPlugins[0].injectableClass);
+  assert.deepEqual(strykerPlugins[0].injectableClass.inject, ClearTextReporter.inject);
+  assert.ok('inject' in strykerPlugins[5].injectableClass);
+  assert.deepEqual(strykerPlugins[5].injectableClass.inject, HtmlReporter.inject);
+  assert.ok('inject' in strykerPlugins[6].injectableClass);
+  assert.deepEqual(strykerPlugins[6].injectableClass.inject, JsonReporter.inject);
+  assert.ok(injector.injectClass(strykerPlugins[0].injectableClass) instanceof ClearTextReporter);
+  assert.ok(injector.injectClass(strykerPlugins[5].injectableClass) instanceof HtmlReporter);
+  assert.ok(injector.injectClass(strykerPlugins[6].injectableClass) instanceof JsonReporter);
+} finally {
+  await injector.dispose();
+  await backend.dispose();
+}
