new file mode 100644
--- /dev/null
+++ b/test/integration/native-process/native-process.test.mjs
@@ -0,0 +1,43 @@
+import assert from 'node:assert/strict'
+import { spawnSync } from 'node:child_process'
+import { readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { test } from 'node:test'
+
+const directory = fileURLToPath(new URL('.', import.meta.url))
+const scenarios = [
+  ['cwd', 0],
+  ['child', 1],
+  ['direct', 1],
+  ['classification', 1],
+  ['browser', 1],
+  ['pertest', 1],
+  ['stale', 1],
+  ['explicit-env', 0],
+  ['threads', 1],
+  ['setup', 1],
+  ['nonisolated', 1],
+  ['collection', 1],
+  ['empty', 1],
+  ['tsx', 1],
+  ['mixed', 1],
+  ['react', 1],
+]
+
+for (const [scenario, expectedExit] of scenarios) {
+  test(`native runner integration: ${scenario}`, () => {
+    const marker = new URL(`./${scenario}-verified.json`, import.meta.url)
+    rmSync(marker, { force: true })
+    const result = spawnSync(process.execPath, ['probe.mjs', scenario], {
+      cwd: directory,
+      encoding: 'utf8',
+      timeout: 60000,
+    })
+    const output = `${result.stdout}${result.stderr}`
+    writeFileSync(new URL(`./${scenario}-case.log`, import.meta.url), output)
+    assert.equal(result.error, undefined, output)
+    assert.equal(result.signal, null, output)
+    assert.equal(result.status, expectedExit, output)
+    assert.deepEqual(JSON.parse(readFileSync(marker, 'utf8')), { repairVerified: true, kind: scenario })
+  })
+}
