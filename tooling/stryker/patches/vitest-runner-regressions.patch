+import { mkdtemp, realpath, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { expect, test } from 'vitest'
+
+test('native process changes and restores its working directory', async () => {
+  const original = process.cwd()
+  const directory = await mkdtemp(join(tmpdir(), 'dsh-runner-cwd-'))
+  try {
+    process.chdir(directory)
+    expect(process.cwd()).toBe(await realpath(directory))
+  } finally {
+    if (process.cwd() !== original) process.chdir(original)
+    await rm(directory, { recursive: true })
+  }
+})
