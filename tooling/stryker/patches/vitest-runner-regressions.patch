diff --git a/test/integration/native-process/probe.mjs b/test/integration/native-process/probe.mjs
new file mode 100644
--- /dev/null
+++ b/test/integration/native-process/probe.mjs
@@ -0,0 +1,130 @@
+import assert from 'node:assert/strict'
+import { readFile, writeFile } from 'node:fs/promises'
+import { fileURLToPath } from 'node:url'
+import { resolve } from 'node:path'
+import { Instrumenter } from '@stryker-mutator/instrumenter'
+import { TestStatus } from '@stryker-mutator/api/test-runner'
+import { INSTRUMENTER_CONSTANTS } from '@stryker-mutator/api/core'
+
+const root = fileURLToPath(new URL('.', import.meta.url))
+assert.equal(process.cwd(), root.slice(0, -1), 'Run this probe from its own isolated directory')
+const coreEntry = import.meta.resolve('@stryker-mutator/core')
+const { LoggingBackend } = await import(new URL('./logging/logging-backend.js', coreEntry))
+const { LoggerImpl } = await import(new URL('./logging/logger-impl.js', coreEntry))
+const { defaultOptions } = await import(new URL('./config/options-validator.js', coreEntry))
+const { VitestTestRunner } = await import('../../../dist/src/vitest-test-runner.js')
+const backend = new LoggingBackend(process.stdout)
+const logger = new LoggerImpl('NativeRunnerProbe', backend)
+const kind = process.argv[2]
+const extension = kind === 'tsx' ? 'ts' : 'mjs'
+const subject = resolve(root, `subject.${extension}`)
+const instrumenter = new Instrumenter(logger)
+const instrumented = await instrumenter.instrument([{
+  name: subject,
+  content: await readFile(new URL(`./subject.original.${extension}`, import.meta.url), 'utf8'),
+  mutate: true,
+}], { plugins: null, excludedMutations: [], ignorers: [] })
+assert.equal(instrumented.files.length, 1)
+assert.ok(instrumented.mutants.length > 0)
+await writeFile(subject, instrumented.files[0].content)
+await writeFile(new URL('./mutant-manifest.json', import.meta.url), JSON.stringify(instrumented.mutants, null, 2))
+
+assert.ok(['cwd', 'child', 'direct', 'classification', 'browser', 'pertest', 'stale', 'explicit-env', 'threads', 'setup', 'nonisolated', 'collection', 'empty', 'tsx', 'mixed', 'react'].includes(kind))
+const configuration = kind === 'pertest' ? 'direct' : kind === 'stale' ? 'child' : kind
+const coverageAnalysis = kind === 'pertest' ? 'perTest' : 'off'
+const environmentKey = INSTRUMENTER_CONSTANTS.ACTIVE_MUTANT_ENV_VARIABLE
+const originalActiveEnvironment = process.env[environmentKey]
+if (kind === 'stale') process.env[environmentKey] = instrumented.mutants[0].id
+const options = {
+  ...defaultOptions,
+  testRunner: 'vitest',
+  vitest: { configFile: resolve(root, `vitest.${configuration}.config.mjs`), related: false, dir: root },
+  coverageAnalysis,
+  disableBail: true,
+  thresholds: { high: 100, low: 99, break: 99 },
+}
+const runner = new VitestTestRunner(options, logger, '__stryker__')
+const observations = { kind, mutantCount: instrumented.mutants.length, mutations: [] }
+try {
+  await runner.init()
+  observations.configuredPool = 'forks'
+  observations.resolvedPools = runner.ctx.projects.map(project => ({ name: project.name, pool: project.config.pool }))
+  const environmentReferences = runner.ctx.projects.map(project => project.config.env)
+  if (kind === 'empty') {
+    await assert.rejects(() => runner.dryRun({ coverageAnalysis, files: [subject], timeout: 30000 }), { code: 'VITEST_FILES_NOT_FOUND' })
+    observations.emptyRejected = true
+  } else {
+  observations.baseline = await runner.dryRun({ coverageAnalysis, files: [subject], timeout: 30000 })
+  if (['child', 'stale', 'explicit-env', 'tsx', 'mixed'].includes(kind)) observations.baselineChild = JSON.parse(await readFile(new URL('./child-observation.json', import.meta.url), 'utf8'))
+  if (kind !== 'cwd') {
+    for (const mutant of instrumented.mutants) {
+      const result = await runner.mutantRun({
+        activeMutant: mutant,
+        sandboxFileName: subject,
+        mutantActivation: kind === 'pertest' ? 'runtime' : 'static',
+        testFilter: kind === 'pertest' ? observations.baseline.tests.map(test => test.id) : undefined,
+        reloadEnvironment: true,
+        timeout: 30000,
+        disableBail: true,
+      })
+      const run = {
+        id: mutant.id,
+        mutatorName: mutant.mutatorName,
+        result,
+        outsideErrors: runner.ctx.state.getUnhandledErrors(),
+      }
+      if (['child', 'stale', 'explicit-env', 'tsx', 'mixed'].includes(kind)) run.child = JSON.parse(await readFile(new URL('./child-observation.json', import.meta.url), 'utf8'))
+      observations.mutations.push(run)
+    }
+    if (kind !== 'classification' && kind !== 'collection') {
+      observations.afterMutantsBaseline = await runner.dryRun({ coverageAnalysis, files: [subject], timeout: 30000 })
+      assert.equal(observations.afterMutantsBaseline.status, 'complete')
+      assert.ok(observations.afterMutantsBaseline.tests.every(test => test.status === TestStatus.Success))
+    }
+  }
+  }
+  assert.ok(runner.ctx.projects.every((project, index) => project.config.env === environmentReferences[index]))
+  await writeFile(new URL(`./${kind}-observations.json`, import.meta.url), JSON.stringify(observations, null, 2))
+  process.stdout.write(`${JSON.stringify(observations, null, 2)}\n`)
+} finally {
+  await runner.dispose()
+  await backend.dispose()
+  if (originalActiveEnvironment === undefined) delete process.env[environmentKey]
+  else process.env[environmentKey] = originalActiveEnvironment
+}
+
+if (kind === 'cwd') {
+  assert.ok(observations.resolvedPools.every(project => project.pool === 'forks'))
+  assert.equal(observations.baseline.status, 'complete')
+  assert.ok(observations.baseline.tests.every(test => test.status === TestStatus.Success))
+} else if (['child', 'stale', 'tsx', 'mixed'].includes(kind)) {
+  assert.equal(observations.baseline.status, 'complete')
+  assert.equal(observations.baselineChild.activeMutant, null)
+  assert.ok(observations.mutations.every(run => run.result.status === 'killed' && run.child.activeMutant === run.id && run.child.value !== 5))
+  if (kind === 'mixed') {
+    assert.equal(observations.baseline.tests.length, 2)
+    assert.equal(observations.afterMutantsBaseline.tests.length, 2)
+    assert.ok(observations.mutations.every(run => run.result.killedBy.length === 2))
+  }
+} else if (['direct', 'browser', 'react', 'pertest', 'threads', 'setup', 'nonisolated'].includes(kind)) {
+  assert.equal(observations.baseline.status, 'complete')
+  assert.ok(observations.mutations.every(run => run.result.status === 'killed'))
+  if (kind === 'pertest') {
+    const testId = observations.baseline.tests[0].id
+    const coverage = observations.baseline.mutantCoverage.perTest[testId]
+    assert.ok(instrumented.mutants.every(mutant => coverage[mutant.id] > 0))
+  }
+  if (kind === 'threads') assert.ok(observations.resolvedPools.every(project => project.pool === 'threads'))
+} else if (kind === 'explicit-env') {
+  assert.ok(observations.mutations.every(run => run.result.status === 'survived' && run.child.activeMutant === null && run.child.value === 5))
+} else if (kind === 'empty') {
+  assert.equal(observations.emptyRejected, true)
+} else if (kind === 'collection') {
+  assert.equal(observations.baseline.status, 'error')
+  assert.ok(observations.mutations.every(run => run.result.status === 'error' && run.result.errorMessage.includes('missing-dependency.mjs')))
+} else {
+  assert.equal(observations.baseline.status, 'error')
+  assert.ok(observations.mutations.every(run => run.result.status === 'error' && run.outsideErrors.length > 0))
+}
+await writeFile(new URL(`./${kind}-verified.json`, import.meta.url), JSON.stringify({ repairVerified: true, kind }))
+process.stdout.write(`Repair verified: ${kind}; Vitest's own exit status is retained.\n`)
