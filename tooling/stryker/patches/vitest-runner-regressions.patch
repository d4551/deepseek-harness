+import { execFileSync } from 'node:child_process'
+import { writeFile } from 'node:fs/promises'
+import { fileURLToPath } from 'node:url'
+import { expect, inject, test } from 'vitest'
+
+test('real child returns five from instrumented source', async () => {
+  const options = inject('childEnvironment') === 'omit' ? { encoding: 'utf8', env: {} } : { encoding: 'utf8' }
+  const output = execFileSync(process.execPath, [fileURLToPath(new URL('./child-entry.mjs', import.meta.url))], options)
+  const result = JSON.parse(output)
+  await writeFile(new URL('./child-observation.json', import.meta.url), output)
+  expect(result.source).toBe(new URL('./subject.mjs', import.meta.url).href)
+  expect(result.value).toBe(5)
+})
