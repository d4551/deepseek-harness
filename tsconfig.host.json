{
  // Host aggregate (one of the two check units; see tsconfig.json). packages/client
  // type-checks in tsconfig.client.json: the two sides merge cordis Context under
  // the same keys, one program cannot see both.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "apps/web/*.ts",
    "apps/web/tests/**/*.ts",
    "apps/web/stress-tests/**/*.ts",
    "apps/cli/tests/**/*.ts",
    "packages/*/*/tests/**/*.ts",
    "scripts/**/*.ts",
    "website/**/*.ts",
    "website/.vitepress/**/*.ts"
  ],
  // A test file names the face it covers: `*.client.*` belongs to the Client
  // aggregate, `*.host.spec.ts` to this one. The two markers are mutually
  // exclusive, so each aggregate excludes the other's and the test globs above
  // need no per-file entry. apps/web/tests follows the same rule: its browser
  // e2e lane reads Host services and stays here unmarked, while the files that
  // mount the Client shell carry `.client.` and type-check in apps/web's own
  // project. scripts/web-program-partition.ts fails the constraints gate when
  // an apps/web file lands in neither program or in both.
  "exclude": [
    "packages/client/*/src/**",
    "apps/web/tests/**/*.client.*",
    "packages/*/*/tests/**/*.client.ts",
    "packages/*/*/tests/**/*.client.tsx",
    "packages/*/*/tests/**/*.client.spec.ts",
    "packages/*/*/tests/**/*.client.spec.tsx",
    "packages/client/tsdown.client.ts",
    "scripts/*.client.spec.ts",
    "scripts/client-bundle-css.spec.ts",
    "packages/typert/generator/tests/fixtures/**",
    "scripts/client-bundle-purity.spec.ts"
  ],
