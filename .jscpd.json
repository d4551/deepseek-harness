{
  "minTokens": 60,
  "minLines": 6,
  "mode": "mild",
  "format": ["typescript", "tsx"],
  "pattern": "**/*.{ts,tsx}",
  "ignore": [
    "**/tests/**",
    "**/tsdown.config.ts",
    "**/cordis-client-runner/src/client/slot-catalog.ts",
    "**/cordis-client-runner/src/client/api-catalog.ts",
    "**/tool-cordis/src/api-catalog.ts"
  ],
  "reporters": ["console"],
  "exitCode": 1,
  "noColors": true,
  "noTips": true
}
